<?xml version='1.0' encoding='utf-8'?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xmlns:ns2="http://schemas.microsoft.com/office/mailappversionoverrides" xmlns:ns4="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="MailApp">
  <Id>21576c29-0c37-4ebe-b795-4a1dac6dc4ee</Id>
  <Version>1.0.0.5</Version>
  <ProviderName>Goodwill of Central and Northern Arizona</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Sophos Quarantine" />
  <Description DefaultValue="Adds an Outlook ribbon button that opens the Sophos Self-Service Quarantine portal." />
  <IconUrl DefaultValue="https://brave-glacier-0e7c1ba1e.7.azurestaticapps.net/icons/icon-64.png" />
  <HighResolutionIconUrl DefaultValue="https://brave-glacier-0e7c1ba1e.7.azurestaticapps.net/icons/icon-128.png" />
  <SupportUrl DefaultValue="https://ithelp.gwaz.org/" />

  <AppDomains>
    <AppDomain>https://cloud.sophos.com</AppDomain>
    <AppDomain>https://brave-glacier-0e7c1ba1e.7.azurestaticapps.net</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.8" />
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://brave-glacier-0e7c1ba1e.7.azurestaticapps.net/outlook/taskpane.html" />
        <RequestedHeight>250</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read" />
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit" />
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>

  <ns2:VersionOverrides xsi:type="VersionOverridesV1_0">
    <ns2:Requirements>
      <bt:Sets DefaultMinVersion="1.8">
        <bt:Set Name="Mailbox" />
      </bt:Sets>
    </ns2:Requirements>

    <ns2:Hosts>
      <ns2:Host xsi:type="MailHost">
        <ns2:DesktopFormFactor>
          <ns2:ExtensionPoint xsi:type="MessageReadCommandSurface">
            <ns2:OfficeTab id="TabDefault">
              <ns2:Group id="SophosQuarantine.ReadGroup">
                <ns2:Label resid="GroupLabel" />
                <ns2:Control xsi:type="Button" id="SophosQuarantine.ReadButton">
                  <ns2:Label resid="OpenSite.Label" />
                  <ns2:Supertip>
                    <ns2:Title resid="OpenSite.Label" />
                    <ns2:Description resid="OpenSite.Description" />
                  </ns2:Supertip>
                  <ns2:Icon>
                    <bt:Image size="16" resid="Icon.16" />
                    <bt:Image size="32" resid="Icon.32" />
                    <bt:Image size="80" resid="Icon.80" />
                  </ns2:Icon>
                  <ns2:Action xsi:type="ShowTaskpane">
                    <ns2:SourceLocation resid="Taskpane.Url" />
                  </ns2:Action>
                </ns2:Control>
              </ns2:Group>
            </ns2:OfficeTab>
          </ns2:ExtensionPoint>

          <ns2:ExtensionPoint xsi:type="MessageComposeCommandSurface">
            <ns2:OfficeTab id="TabDefault">
              <ns2:Group id="SophosQuarantine.ComposeGroup">
                <ns2:Label resid="GroupLabel" />
                <ns2:Control xsi:type="Button" id="SophosQuarantine.ComposeButton">
                  <ns2:Label resid="OpenSite.Label" />
                  <ns2:Supertip>
                    <ns2:Title resid="OpenSite.Label" />
                    <ns2:Description resid="OpenSite.Description" />
                  </ns2:Supertip>
                  <ns2:Icon>
                    <bt:Image size="16" resid="Icon.16" />
                    <bt:Image size="32" resid="Icon.32" />
                    <bt:Image size="80" resid="Icon.80" />
                  </ns2:Icon>
                  <ns2:Action xsi:type="ShowTaskpane">
                    <ns2:SourceLocation resid="Taskpane.Url" />
                  </ns2:Action>
                </ns2:Control>
              </ns2:Group>
            </ns2:OfficeTab>
          </ns2:ExtensionPoint>
        </ns2:DesktopFormFactor>
      </ns2:Host>
    </ns2:Hosts>

    <ns2:Resources>
      <bt:Images>
        <bt:Image id="Icon.16" DefaultValue="https://brave-glacier-0e7c1ba1e.7.azurestaticapps.net/icons/icon-16.png" />
        <bt:Image id="Icon.32" DefaultValue="https://brave-glacier-0e7c1ba1e.7.azurestaticapps.net/icons/icon-32.png" />
        <bt:Image id="Icon.80" DefaultValue="https://brave-glacier-0e7c1ba1e.7.azurestaticapps.net/icons/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://brave-glacier-0e7c1ba1e.7.azurestaticapps.net/outlook/taskpane.html" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="Sophos" />
        <bt:String id="OpenSite.Label" DefaultValue="Open Quarantine" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="OpenSite.Description" DefaultValue="Open the Sophos Self-Service Quarantine portal." />
      </bt:LongStrings>
    </ns2:Resources>

    <ns4:VersionOverrides xsi:type="VersionOverridesV1_1">
      <ns4:Requirements>
        <bt:Sets DefaultMinVersion="1.8">
          <bt:Set Name="Mailbox" />
        </bt:Sets>
      </ns4:Requirements>

      <ns4:Hosts>
        <ns4:Host xsi:type="MailHost">
          <ns4:MobileFormFactor>
            <ns4:ExtensionPoint xsi:type="MobileMessageReadCommandSurface">
              <ns4:Group id="SophosQuarantine.MobileGroup">
                <ns4:Label resid="GroupLabel" />
                <ns4:Control xsi:type="MobileButton" id="SophosQuarantine.MobileButton">
                  <ns4:Label resid="OpenSite.Label" />
                  <ns4:Icon xsi:type="bt:MobileIconList">
                    <bt:Image size="25" scale="1" resid="MobileIcon.25" />
                    <bt:Image size="25" scale="2" resid="MobileIcon.32" />
                    <bt:Image size="25" scale="3" resid="MobileIcon.48" />
                  </ns4:Icon>
                  <ns4:Action xsi:type="ShowTaskpane">
                    <ns4:SourceLocation resid="Taskpane.Url" />
                  </ns4:Action>
                </ns4:Control>
              </ns4:Group>
            </ns4:ExtensionPoint>
          </ns4:MobileFormFactor>
        </ns4:Host>
      </ns4:Hosts>

      <ns4:Resources>
        <bt:Images>
          <bt:Image id="MobileIcon.25" DefaultValue="https://brave-glacier-0e7c1ba1e.7.azurestaticapps.net/icons/icon-32.png" />
          <bt:Image id="MobileIcon.32" DefaultValue="https://brave-glacier-0e7c1ba1e.7.azurestaticapps.net/icons/icon-32.png" />
          <bt:Image id="MobileIcon.48" DefaultValue="https://brave-glacier-0e7c1ba1e.7.azurestaticapps.net/icons/icon-64.png" />
        </bt:Images>
        </ns4:Resources>
    </ns4:VersionOverrides>
  </ns2:VersionOverrides>
</OfficeApp>